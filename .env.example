# =============================================================================
# Invoca SDK / CLI / MCP configuration
# =============================================================================
#
# Quick start for local dev: copy this file to `.env` at the repo root and
# fill in the values you need. The postinstall hook symlinks .env into every
# package, so credentials are picked up no matter which package you're in.
#
# For day-to-day CLI use, export these from your shell startup file instead
# (~/.zshrc on macOS default, ~/.bashrc on Linux, $PROFILE on Windows
# PowerShell). Example for zsh:
#
#   cat >> ~/.zshrc <<'EOF'
#   # Invoca CLI defaults
#   export INVOCA_OAUTH_TOKEN="<your-raw-token>"
#   export INVOCA_NETWORK="<your-network-subdomain>"
#   export INVOCA_ROLE="advertiser"
#   export INVOCA_ADVERTISER_ID="<your-advertiser-id>"
#   EOF
#   source ~/.zshrc
#
# Once set, you can run `invoca transactions list` with no flags. Override on
# any single call by passing --as / --id explicitly. Inspect what the CLI
# actually resolved with: `invoca config show`.
# =============================================================================


# --- Required ----------------------------------------------------------------

# OAuth token for the Signal + Transactions APIs.
# Sent verbatim as the Authorization header — no Bearer prefix (that's how
# Invoca's API is documented).
INVOCA_OAUTH_TOKEN=

# Network subdomain — the bit before .invoca.net.
# Example: if your Invoca URL is `mynetwork.invoca.net`, set this to `mynetwork`.
INVOCA_NETWORK=


# --- Role defaults (lets you skip --as / --id on every command) --------------
#
# Resolution precedence (highest wins):
#   1. explicit CLI flag (--as / --id)
#   2. --profile <name>   (named profile)
#   3. env vars below
#
# `INVOCA_ROLE` selects which of the three *_ID env vars is used as the
# default for `--id`. You can set all three IDs and switch roles freely.

# One of: advertiser | network | affiliate
INVOCA_ROLE=

# Your Invoca advertiser ID (used when INVOCA_ROLE=advertiser)
INVOCA_ADVERTISER_ID=

# Your Invoca network ID (used when INVOCA_ROLE=network)
#   Note: this is the *numeric ID*, not the subdomain. INVOCA_NETWORK above
#   is the subdomain used to build the API host; INVOCA_NETWORK_ID is the
#   ID you pass to the Transactions API as the "network role" identifier.
INVOCA_NETWORK_ID=

# Your Invoca affiliate ID (used when INVOCA_ROLE=affiliate)
INVOCA_AFFILIATE_ID=


# --- Optional ----------------------------------------------------------------

# Request timeout in milliseconds (default 30000).
# INVOCA_TIMEOUT_MS=30000

# Per-family base URL overrides — for sandboxes or routing through a proxy.
# INVOCA_BASE_URL_RINGPOOL=https://...
# INVOCA_BASE_URL_PNAPI=https://...
# INVOCA_BASE_URL_SIGNAL=https://...
# INVOCA_BASE_URL_TRANSACTIONS=https://...

# Optional feedback collector — `invoca feedback "<msg>"` will POST here in
# addition to writing to the local ledger. Failures don't block the command.
# INVOCA_FEEDBACK_ENDPOINT=https://...


# --- E2E test inputs (optional) ----------------------------------------------
#
# Independent from the role defaults above — these are read only by the SDK's
# e2e test suite (`bun run test:e2e`). Each role's tests auto-skip when its
# ID is unset, so populate only what you have access to.

INVOCA_E2E_ADVERTISER_ID=
INVOCA_E2E_NETWORK_ID=
INVOCA_E2E_AFFILIATE_ID=
