# Invoca SDK / CLI / MCP configuration
# Copy to .env and fill in. .env is gitignored.

# OAuth token for the Signal + Transactions APIs (required for those families).
# Invoca sends this as the raw "Authorization: <token>" header value
# (no Bearer prefix — that's how their API is documented).
INVOCA_OAUTH_TOKEN=

# Network subdomain used to build <network>.invoca.net for ringpool/transactions hosts.
# Example: if your platform URL is mynetwork.invoca.net, set INVOCA_NETWORK=mynetwork.
INVOCA_NETWORK=

# Optional: override request timeout (default 30000 ms).
# INVOCA_TIMEOUT_MS=30000

# Optional: per-family base URL overrides (sandbox/testing).
# INVOCA_BASE_URL_RINGPOOL=https://...
# INVOCA_BASE_URL_PNAPI=https://...
# INVOCA_BASE_URL_SIGNAL=https://...
# INVOCA_BASE_URL_TRANSACTIONS=https://...

# ---------------------------------------------------------------------------
# E2E test inputs (optional). Each is gated independently; tests for a role
# auto-skip when its ID is unset, so populate only what you have access to.
# ---------------------------------------------------------------------------
INVOCA_E2E_ADVERTISER_ID=
INVOCA_E2E_NETWORK_ID=
INVOCA_E2E_AFFILIATE_ID=
