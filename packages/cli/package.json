{
  "name": "@invoca-toolkit/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "invoca": "src/bin.ts"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "bun build ./src/bin.ts --compile --outfile dist/invoca",
    "build:darwin-arm64": "bun build ./src/bin.ts --compile --target=bun-darwin-arm64 --outfile dist/invoca-darwin-arm64",
    "build:darwin-x64": "bun build ./src/bin.ts --compile --target=bun-darwin-x64 --outfile dist/invoca-darwin-x64",
    "build:linux-x64": "bun build ./src/bin.ts --compile --target=bun-linux-x64 --outfile dist/invoca-linux-x64",
    "build:windows-x64": "bun build ./src/bin.ts --compile --target=bun-windows-x64 --outfile dist/invoca-windows-x64.exe",
    "build:skill": "bun run scripts/build-skill.ts",
    "vocab-lint": "bun run scripts/lint-vocab.ts",
    "test": "bun test",
    "lint": "tsc --noEmit && bun run vocab-lint"
  },
  "dependencies": {
    "@invoca-toolkit/sdk": "workspace:*",
    "@stricli/core": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "latest"
  }
}
